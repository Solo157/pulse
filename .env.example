# Pulse DEMO — environment template. Copy to `.env` and adjust.
# Secrets are kept OUT of git. Only non-secret defaults live here.

# --- General ---
PULSE_NETWORK=pulse

# --- PostgreSQL (single DB, per-service schemas) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me

# --- Kafka (2 brokers, KRaft, RF=2, minISR=2) ---
KAFKA_BOOTSTRAP_SERVERS=kafka1:29092,kafka2:29092
KAFKA_METRICS_TOPIC=metrics
KAFKA_INCIDENTS_TOPIC=incidents
KAFKA_METRICS_PARTITIONS=2
KAFKA_INCIDENTS_PARTITIONS=2

# --- ClickHouse (single node, no sharding) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=pulse
CLICKHOUSE_USER=pulse
CLICKHOUSE_PASSWORD=change-me

# --- Redis (API idempotency keys; also persisted to PostgreSQL) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MetricService ---
METRIC_SERVER_PORT=8080

# --- StorageService / ProcessingService / NotificationService ---
STORAGE_SERVER_PORT=8081
PROCESSING_SERVER_PORT=8082
NOTIFICATION_SERVER_PORT=8083

# --- Monitoring rule (DEMO single global rule) ---
RULE_METRIC_NAME=temperature
RULE_THRESHOLD=80
RULE_COOLDOWN_SECONDS=60

# --- Grafana (obs profile) ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me
