# Pulse DEMO — шаблон переменных окружения. Скопировать в `.env` и настроить.
# Секреты в git не попадают; здесь только безобидные значения по умолчанию.
#
# docker compose подхватывает из этого файла и подставляет в контейнеры
# фактически только POSTGRES_*, CLICKHOUSE_* и GF_ADMIN_* — они перечислены
# в docker-compose.yml как ${...}. Остальные переменные — значения по умолчанию
# для запуска сервиса вне compose (Spring читает их из окружения процесса).

# --- PostgreSQL (одна база, своя схема у каждого сервиса) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me

# --- Топики Kafka (имена, которые ожидают продюсеры и консьюмеры) ---
KAFKA_METRICS_TOPIC=metrics
KAFKA_INCIDENTS_TOPIC=incidents

# --- ClickHouse (один узел, без шардирования) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_DB=pulse
CLICKHOUSE_USER=pulse
CLICKHOUSE_PASSWORD=change-me

# --- Порты сервисов (совпадают со значением по умолчанию в их application.yml) ---
METRIC_SERVER_PORT=8080
STORAGE_SERVER_PORT=8081
PROCESSING_SERVER_PORT=8082
NOTIFICATION_SERVER_PORT=8083

# --- Grafana (профиль obs) ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me
