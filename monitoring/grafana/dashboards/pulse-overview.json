{
 "title": "Pulse overview (Этапы 1-5)",
 "uid": "pulse-overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS_PROMETHEUS",
    "type": "datasource",
    "query": "prometheus",
    "current": {
     "selected": false,
     "text": "Prometheus",
     "value": "prometheus"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Ingest accepted (FR-1)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(pulse_ingest_accepted_total[1m]))",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Ingest rejected / replay (outcome)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (outcome) (rate(pulse_ingest_rejected_total[1m]))",
     "legendFormat": "rejected {{outcome}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "expr": "sum(rate(pulse_ingest_idempotent_replay_total[1m]))",
     "legendFormat": "idempotent replay",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Kafka publish failures (FR-1)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(pulse_kafka_publish_failure_total[5m]))",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Storage inserted points (FR-2)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(pulse_storage_inserted_points_total[1m]))",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Storage insert duration avg (FR-1)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "rate(pulse_storage_insert_duration_seconds_sum[1m]) / rate(pulse_storage_insert_duration_seconds_count[1m])",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Processing points / notifications (FR-3/FR-2)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(pulse_processing_points_total[1m]))",
     "legendFormat": "processing points",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "expr": "sum by (status) (rate(pulse_notifications_total[1m]))",
     "legendFormat": "notifications {{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "HTTP request rate by service",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (service, uri) (rate(http_server_requests_seconds_count[1m]))",
     "legendFormat": "{{service}} {{uri}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "HTTP p95 latency (FR-1 latency)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_requests_seconds_bucket[5m])))",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "JVM heap used / max ratio (resource)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "max by (service) (jvm_memory_used_bytes{area=\"heap\"}) / max by (service) (jvm_memory_max_bytes{area=\"heap\"} > 0)",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Process CPU load (resource)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "max by (service) (process_cpu_usage)",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Uptime (scale-up visibility)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "time() - max by (instance, service) (process_start_time_seconds)",
     "legendFormat": "{{service}} {{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  }
 ]
}